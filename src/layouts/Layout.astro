---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Parents in Tech - A global community of tech parents building the future for their families" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body>
		<div class="grain-overlay"></div>
		<Navbar />
		<slot />
		<Footer />
	</body>
</html>
<style is:global>
	:root {
		/* Primary Colors */
		--primary-50: #f7f5f2;
		--primary-100: #f0f6d8;
		--primary-200: #e5f0b3;
		--primary-300: #deea6f;
		--primary-400: #d4e34c;
		--primary-500: #c9e001;
		--primary-600: #aeca01;
		--primary-700: #8faa04;
		--primary-800: #75861a;
		--primary-900: #696c23;
		--primary-950: #35390f;

		/* Gradients */
		--gradient-primary: linear-gradient(135deg, #deea6f 0%, #c9e001 100%);
		--gradient-secondary: linear-gradient(135deg, #f7f5f2 0%, #b2b38e 100%);
		--gradient-accent: linear-gradient(135deg, #c9e001 0%, #696c23 100%);
		--gradient-warm: linear-gradient(135deg, #deea6f 0%, #f7f5f2 100%);
		--gradient-cool: linear-gradient(135deg, #f7f5f2 0%, #d4e34c 100%);
		--gradient-dark: linear-gradient(135deg, #2d3013 0%, #696c23 100%);

		/* Background Colors */
		--bg-primary: #12140a;
		--bg-secondary: #191c0c;
		--bg-tertiary: #22260f;
		--bg-card: rgba(222, 234, 111, 0.12);
		--bg-card-hover: rgba(201, 224, 1, 0.18);

		/* Text Colors */
		--text-primary: #f7f5f2;
		--text-secondary: rgba(247, 245, 242, 0.82);
		--text-tertiary: rgba(247, 245, 242, 0.64);
		--text-accent: #c9e001;

		/* Border Colors */
		--border-primary: rgba(247, 245, 242, 0.12);
		--border-secondary: rgba(247, 245, 242, 0.06);
		--border-accent: rgba(201, 224, 1, 0.4);

		/* Shadows */
		--shadow-sm: 0 1px 2px 0 rgba(17, 20, 10, 0.35);
		--shadow-md: 0 4px 6px -1px rgba(17, 20, 10, 0.4);
		--shadow-lg: 0 12px 24px -8px rgba(54, 62, 24, 0.45);
		--shadow-xl: 0 20px 32px -12px rgba(54, 62, 24, 0.55);
		--shadow-glow: 0 0 22px rgba(201, 224, 1, 0.35);

		/* Spacing */
		--space-xs: 0.25rem;
		--space-sm: 0.5rem;
		--space-md: 1rem;
		--space-lg: 1.5rem;
		--space-xl: 2rem;
		--space-2xl: 3rem;
		--space-3xl: 4rem;

		/* Border Radius */
		--radius-sm: 0.375rem;
		--radius-md: 0.5rem;
		--radius-lg: 0.75rem;
		--radius-xl: 1rem;
		--radius-2xl: 1.5rem;
		--radius-full: 9999px;

		/* Typography */
		--font-size-xs: 0.75rem;
		--font-size-sm: 0.875rem;
		--font-size-base: 1rem;
		--font-size-lg: 1.125rem;
		--font-size-xl: 1.25rem;
		--font-size-2xl: 1.5rem;
		--font-size-3xl: 1.875rem;
		--font-size-4xl: 2.25rem;
		--font-size-5xl: 3rem;
		--font-size-6xl: 3.75rem;
		--font-size-7xl: 4.5rem;
		--font-size-8xl: 6rem;
		--font-size-9xl: 8rem;

		/* Line Heights */
		--leading-none: 1;
		--leading-tight: 1.25;
		--leading-snug: 1.375;
		--leading-normal: 1.5;
		--leading-relaxed: 1.625;
		--leading-loose: 2;

		/* Font Weights */
		--font-light: 300;
		--font-normal: 400;
		--font-medium: 500;
		--font-semibold: 600;
		--font-bold: 700;
		--font-extrabold: 800;
		--font-black: 900;
	}

	* {
		box-sizing: border-box;
	}

	html {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
		background: var(--bg-primary);
		scroll-behavior: smooth;
		overflow-x: hidden;
	}

	body {
		margin: 0;
		padding: 0;
		color: var(--text-primary);
		line-height: var(--leading-normal);
		font-weight: var(--font-normal);
		position: relative;
		min-height: 100vh;
	background: 
		radial-gradient(circle at 20% 80%, rgba(222, 234, 111, 0.24) 0%, transparent 55%),
		radial-gradient(circle at 80% 20%, rgba(201, 224, 1, 0.2) 0%, transparent 55%),
		radial-gradient(circle at 45% 35%, rgba(178, 179, 142, 0.18) 0%, transparent 60%),
		var(--bg-primary);
		background-attachment: fixed;
	}

	.grain-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 1;
		opacity: 0.03;
		background-image: 
			radial-gradient(circle at 25% 25%, rgba(255, 255, 255, 0.1) 1px, transparent 1px),
			radial-gradient(circle at 75% 75%, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
		background-size: 50px 50px;
		animation: grain 8s steps(10) infinite;
	}

	@keyframes grain {
		0%, 100% { transform: translate(0, 0); }
		10% { transform: translate(-5%, -10%); }
		20% { transform: translate(-15%, 5%); }
		30% { transform: translate(7%, -25%); }
		40% { transform: translate(-5%, 25%); }
		50% { transform: translate(-15%, 10%); }
		60% { transform: translate(15%, 0%); }
		70% { transform: translate(0%, 15%); }
		80% { transform: translate(3%, 35%); }
		90% { transform: translate(-10%, 10%); }
	}

	/* Typography Utilities */
	.text-gradient {
		background: linear-gradient(135deg, var(--primary-400), var(--primary-600));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.text-glow {
		text-shadow: 0 0 20px rgba(201, 224, 1, 0.45);
	}

	/* Animation Utilities */
	.animate-float {
		animation: float 6s ease-in-out infinite;
	}

	/* Global card styling */
	.card {
		position: relative;
		overflow: hidden;
		background: linear-gradient(155deg, rgba(36, 42, 14, 0.92), rgba(105, 108, 35, 0.88));
		border: 1px solid var(--border-primary);
		border-radius: 1.25rem;
		padding: 2rem;
		backdrop-filter: blur(14px);
		transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
		box-shadow: 0 24px 45px -20px rgba(18, 20, 10, 0.85), 0 18px 32px -16px rgba(201, 224, 1, 0.4);
	}

	.card::before {
		content: '';
		position: absolute;
		top: -40%;
		right: -30%;
		width: 55%;
		height: 140%;
		background: radial-gradient(circle, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0) 70%);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.card:hover {
		border-color: rgba(201, 224, 1, 0.45);
		transform: translateY(-6px);
		box-shadow: 0 30px 55px -24px rgba(24, 28, 12, 0.9), 0 22px 42px -20px rgba(222, 234, 111, 0.55);
	}

	.card:hover::before {
		opacity: 1;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-20px); }
	}

	.animate-pulse-slow {
		animation: pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.5; }
	}

	.animate-bounce-slow {
		animation: bounce 3s infinite;
	}

	@keyframes bounce {
		0%, 100% {
			transform: translateY(-25%);
			animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
		}
		50% {
			transform: translateY(0);
			animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
		}
	}

	/* Scrollbar Styling */
	::-webkit-scrollbar {
		width: 8px;
	}

	::-webkit-scrollbar-track {
		background: var(--bg-secondary);
	}

	::-webkit-scrollbar-thumb {
		background: var(--primary-600);
		border-radius: var(--radius-full);
	}

	::-webkit-scrollbar-thumb:hover {
		background: var(--primary-500);
	}

	/* Selection Styling */
	::selection {
		background: var(--primary-600);
		color: white;
	}

	::-moz-selection {
		background: var(--primary-600);
		color: white;
	}

	/* Focus Styles */
	*:focus {
		outline: 2px solid var(--primary-500);
		outline-offset: 2px;
	}

	/* Code Styling */
	code {
		font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace;
		background: var(--bg-tertiary);
		padding: 0.25rem 0.5rem;
		border-radius: var(--radius-sm);
		font-size: 0.875em;
		color: var(--primary-300);
	}

	/* Utility Classes */
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 var(--space-lg);
	}

	.container-wide {
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 var(--space-lg);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* Responsive Typography */
	@media (max-width: 768px) {
		html {
			font-size: 14px;
		}
		
		.container,
		.container-wide {
			padding: 0 var(--space-md);
		}
	}

	@media (max-width: 480px) {
		html {
			font-size: 13px;
		}
		
		.container,
		.container-wide {
			padding: 0 var(--space-sm);
		}
	}
</style>
