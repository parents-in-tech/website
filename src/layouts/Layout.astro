---
import '../styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const { title, description, canonical, ogImage, noIndex = false } = Astro.props;
const canonicalUrl = canonical ? new URL(canonical, Astro.url).toString() : undefined;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.url).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const modeKey = 'pit-theme-mode';
          const paletteKey = 'pit-theme-palette';
          const root = document.documentElement;
          const savedTheme = localStorage.getItem(modeKey);
          const savedPalette = localStorage.getItem(paletteKey);
          const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = savedTheme ?? (systemPrefersDark ? 'dark' : 'light');
          const validPalettes = ['copper', 'blue', 'violet', 'firefly', 'lantern'];
          const palette = validPalettes.includes(savedPalette ?? '') ? savedPalette : 'copper';

          root.classList.toggle('dark', theme === 'dark');
          root.dataset.palette = palette;
        } catch {
          document.documentElement.classList.toggle(
            'dark',
            window.matchMedia('(prefers-color-scheme: dark)').matches,
          );
          document.documentElement.dataset.palette = 'copper';
        }
      })();
    </script>
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl ?? Astro.url.toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {ogImageUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta name="twitter:image" content={ogImageUrl} />
      </>
    )}
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
