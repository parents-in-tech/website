---
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/PageIntro.astro';
import ValueGrid from '@/components/ValueGrid.astro';
import { aboutPrinciples, missionStatement, roadmapThemes } from '@/lib/site';
---

<Layout
  title="About | Parents in Tech"
  description="Learn the Parents in Tech mission, how the community works across X and GitHub, and what principles guide contribution."
>
  <PageIntro
    eyebrow="About"
    title="A mission-driven community for parents who build."
    lead="Parents in Tech exists to create safe, ad-free, and dopamine-free digital apps for our kids by bringing parents together in the open."
  />

  <section class="pb-8 md:pb-12">
    <div class="page-shell grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <article class="editorial-panel p-8 md:p-10">
        <div class="eyebrow">Mission</div>
        <h2 class="mt-5 text-4xl leading-tight md:text-5xl">{missionStatement}</h2>
        <p class="mt-5 text-sm leading-7 text-muted-foreground md:text-base">
          That mission is the shared standard for the community. It shapes what gets built, how people contribute, and what kinds of digital experiences belong inside the organization.
        </p>
      </article>

      <div class="grid gap-6">
        <article class="editorial-panel p-7">
          <h3 class="text-2xl">How the community works</h3>
          <p class="mt-4 text-sm leading-7 text-muted-foreground">
            The GitHub organization is where the repos, issues, codebases, and demos live, and where people gather, discuss ideas, and share progress.
          </p>
        </article>

        <article class="editorial-panel p-7">
          <h3 class="text-2xl">What contribution should feel like</h3>
          <p class="mt-4 text-sm leading-7 text-muted-foreground">
            Open, respectful, and grounded in standard open-source practice: discuss ideas in the open, keep work scoped, document changes, and stay aligned with the mission.
          </p>
        </article>
      </div>
    </div>
  </section>

  <ValueGrid
    eyebrow="Principles"
    title="Principles that keep the mission real."
    lead="These are the guardrails for what gets built and how people work together."
    items={aboutPrinciples}
  />

  <section class="section-space pt-2">
    <div class="page-shell">
      <div class="section-heading">
        <div class="eyebrow">Roadmap</div>
        <h2 class="text-4xl leading-tight text-balance md:text-5xl">What the community is building toward.</h2>
        <p class="section-lead">
          These themes keep the work practical: better mission-aligned apps, better contributor onboarding, and better stewardship of the community itself.
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {roadmapThemes.map((theme) => (
          <article class="editorial-panel p-7">
            <h3 class="text-2xl">{theme.title}</h3>
            <p class="mt-4 text-sm leading-7 text-muted-foreground">{theme.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
