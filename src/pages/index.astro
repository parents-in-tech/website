---
import ContributionPath from '@/components/ContributionPath.astro';
import { FaqList } from '@/components/FaqList';
import Hero from '@/components/Hero.astro';
import JoinSteps from '@/components/JoinSteps.astro';
import Layout from '@/layouts/Layout.astro';
import { ProjectPreview } from '@/components/ProjectPreview';
import ProofStrip from '@/components/ProofStrip.astro';
import ValueGrid from '@/components/ValueGrid.astro';
import { communityProof, contributionTracks, homepageFaq, journeySteps, missionStatement, valuePillars } from '@/lib/site';
---

<Layout
  title="Parents in Tech"
  description="Parents in Tech is a mission-driven community creating safe, ad-free, and dopamine-free digital apps for our kids through open community and open-source contribution."
>
  <Hero />
  <ProofStrip items={communityProof} />

  <ValueGrid
    eyebrow="Mission"
    title={missionStatement}
    lead="Parents in Tech is an open community on X with an open-source GitHub organization behind it. The mission sets the standard for what gets built and how the community contributes."
    items={valuePillars}
  />

  <ProjectPreview
    client:visible
    limit={3}
    title="Projects already moving inside the GitHub organization"
    lead="The repos page is meant to show the real codebases and any demo URLs attached to them, so people can see the work before they contribute."
  />

  <JoinSteps items={journeySteps} />
  <ContributionPath items={contributionTracks} />

  <section class="section-space">
    <div class="page-shell grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="section-heading">
        <div class="eyebrow">FAQ</div>
        <h2 class="text-4xl leading-tight text-balance md:text-5xl">Questions that usually come up before someone joins.</h2>
        <p class="section-lead">
          Straight answers about the mission, the community, and how open-source contribution works here.
        </p>
      </div>

      <FaqList client:visible items={homepageFaq} />
    </div>
  </section>

  <section class="section-space pt-4">
    <div class="page-shell">
      <div class="editorial-panel grid gap-6 overflow-hidden lg:grid-cols-[1fr_auto] lg:items-center">
        <div class="surface-wash p-8 md:p-10">
          <div class="eyebrow">Next step</div>
          <h2 class="mt-5 text-4xl leading-tight md:text-5xl">Join the community, then choose where you want to contribute.</h2>
          <p class="mt-5 max-w-2xl text-sm leading-7 text-muted-foreground md:text-base">
            Start in the X community, explore the repos, and request GitHub access when you are ready to contribute in the open.
          </p>
        </div>
        <div class="px-8 pb-8 lg:pr-10 lg:pb-0">
          <a
            href="/invite"
            class="inline-flex h-12 items-center justify-center rounded-full bg-primary px-6 text-base font-medium text-primary-foreground [box-shadow:var(--primary-shadow)] transition hover:bg-primary/92"
          >
            Join the community
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
