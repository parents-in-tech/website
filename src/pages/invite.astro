---
import Layout from '../layouts/Layout.astro';

const url = new URL(Astro.request.url);
const success = url.searchParams.get('success');
const error = url.searchParams.get('error');
---

<Layout title="Join Parents in Tech">
	<main>
		<div class="container">
			<div class="hero-section">
				<h1>Join Our Community</h1>
				<p class="hero-subtitle">Plug into our global network—hang out with fellow tech parents in the X Community and collaborate on open-source projects through GitHub.</p>
			</div>

			<div class="content-grid">
				<div class="card community-options">
					<div class="community-option">
						<div class="option-badge">Social Hub</div>
						<h2>Join the X Community</h2>
						<p>Jump into live discussions, swap parenting hacks, share wins, and take part in community AMAs tailored for tech families.</p>
						<a href="https://x.com/i/communities/1969469616515674424" class="cta-button secondary" target="_blank" rel="noopener noreferrer">Open X Community</a>
					</div>
					<div class="community-option">
						<div class="option-badge">Build Together</div>
						<h2>Contribute on GitHub</h2>
						<p>Request an org invite to help ship open-source tools, docs, and experiments that make family tech life better.</p>
						<a href="#github-invite" class="cta-button secondary">Request GitHub Access</a>
					</div>
				</div>

				{success && (
					<div class="message success">
						<h3>Invitation Sent!</h3>
						<p>Check your email for the GitHub organization invitation. Welcome to Parents in Tech!</p>
					</div>
				)}

				{error && (
					<div class="message error">
						<h3>Invitation Failed</h3>
						{error === 'missing-identifier' && <p>Please provide a valid GitHub username or email address.</p>}
						{error === 'user-not-found' && <p>GitHub user not found. Please check your username and try again.</p>}
						{error === 'already-member' && <p>You're already a member of the Parents in Tech organization.</p>}
						{error === 'pending-invitation' && <p>You already have a pending invitation. Check your email for the GitHub invitation.</p>}
						{error === 'membership-conflict' && <p>GitHub reports you're already associated with this organization, but we can't verify your status. Please check your GitHub notifications or contact us.</p>}
						{error === 'validation-failed' && <p>GitHub validation failed. Please check your username/email and try again.</p>}
						{error === 'need-org-admin' && <p>The GitHub token needs organization admin permissions. Please contact the organization owner to set up proper permissions.</p>}
						{error === 'permission-denied' && <p>Unable to send invitation due to permissions. Please contact us directly.</p>}
						{error === 'server-config' && <p>Server configuration issue. Please contact us directly at <a href="mailto:hello@parentsintech.org">hello@parentsintech.org</a>.</p>}
						{error === 'github-api' && <p>GitHub API error. Please try again later.</p>}
						{!['missing-identifier', 'user-not-found', 'already-member', 'pending-invitation', 'membership-conflict', 'validation-failed', 'need-org-admin', 'permission-denied', 'server-config', 'github-api'].includes(error) && 
							<p>There was an issue sending your invitation. Please try again or contact us if the problem persists.</p>}
					</div>
				)}

				{!success && (
					<form method="POST" action="/api/invite" class="card invite-form" id="github-invite">
						<div class="form-group">
							<label for="identifier">GitHub Username or Email</label>
							<input 
								type="text" 
								id="identifier" 
								name="identifier" 
								placeholder="your-username or email@example.com"
								required 
							/>
						</div>
						<button type="submit" class="cta-button primary">Request Invite</button>
					</form>
				)}

				<div class="card info-section">
					<h2>Why Join?</h2>
					<ul>
						<li><a href="https://x.com/i/communities/1969469616515674424" target="_blank" rel="noopener noreferrer">Hang out in our X Community</a> for day-to-day support, async meetups, and parent-led AMAs.</li>
						<li>Collaborate on GitHub to design, code, and document open-source projects that families can immediately use.</li>
						<li>Pair up with peers for co-working sessions, accountability squads, and hack weekends.</li>
						<li>Share resources, lessons learned, and experiments so every tech parent can thrive.</li>
					</ul>
				</div>
			</div>
		</div>
	</main>
</Layout>

<style>
	main {
		margin: auto;
		padding: 80px 1.5rem 1.5rem;
		color: var(--text-primary);
		min-height: 60vh;
	}

	.container {
		max-width: 760px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.hero-section {
		text-align: center;
	}

	.hero-section h1 {
		font-size: 3rem;
		font-weight: 800;
		margin-bottom: 1rem;
		background: linear-gradient(135deg, #deea6f, #c9e001);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.2rem;
		opacity: 0.85;
		max-width: 620px;
		margin: 0 auto;
		line-height: 1.6;
	}

	.content-grid {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.community-options {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.75rem;
	}

	.community-option {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.75rem;
		background: rgba(18, 20, 10, 0.55);
		border: 1px solid rgba(201, 224, 1, 0.25);
		border-radius: 1rem;
		box-shadow: 0 18px 36px -20px rgba(18, 20, 10, 0.65);
	}

	.option-badge {
		align-self: flex-start;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		background: rgba(201, 224, 1, 0.16);
		color: var(--text-primary);
	}

	.community-option h2 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--text-primary);
	}

	.community-option p {
		margin: 0;
		line-height: 1.6;
		opacity: 0.9;
	}

	.message {
		padding: 1.75rem;
		border-radius: 1rem;
		border: 1px solid var(--border-primary);
		background: rgba(247, 245, 242, 0.05);
		backdrop-filter: blur(12px);
		text-align: left;
	}

	.message h3 {
		margin: 0 0 0.75rem;
		font-size: 1.3rem;
		font-weight: 700;
	}

	.message p {
		margin: 0;
		line-height: 1.6;
	}

	.message.success {
		background: rgba(201, 224, 1, 0.12);
		border-color: rgba(201, 224, 1, 0.35);
	}

	.message.error {
		background: rgba(220, 72, 72, 0.12);
		border-color: rgba(220, 72, 72, 0.4);
	}

	.invite-form {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		scroll-margin-top: 140px;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 0;
		text-align: left;
	}

	.form-group label {
		font-weight: 600;
		color: var(--text-primary);
		font-size: 0.95rem;
	}

	.form-group input {
		width: 100%;
		padding: 0.85rem 1rem;
		border: 1px solid rgba(247, 245, 242, 0.18);
		border-radius: 0.75rem;
		background-color: rgba(247, 245, 242, 0.08);
		color: var(--text-primary);
		font-size: 1rem;
		box-sizing: border-box;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.form-group input:focus {
		outline: none;
		border-color: rgba(201, 224, 1, 0.6);
		box-shadow: 0 0 0 3px rgba(201, 224, 1, 0.18);
	}

	.form-group input::placeholder {
		color: rgba(247, 245, 242, 0.55);
	}

	.cta-button {
		align-self: flex-start;
		padding: 0.85rem 2rem;
		border-radius: 0.75rem;
		text-decoration: none;
		font-weight: 600;
		border: none;
		cursor: pointer;
		font-size: 1rem;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.cta-button.secondary {
		background: transparent;
		color: var(--text-primary);
		border: 1px solid rgba(201, 224, 1, 0.45);
		box-shadow: 0 8px 24px -12px rgba(201, 224, 1, 0.35);
	}

	.cta-button.secondary:hover {
		transform: translateY(-3px);
		box-shadow: 0 16px 32px -18px rgba(201, 224, 1, 0.45);
		background: rgba(201, 224, 1, 0.12);
	}

	.cta-button.primary {
		background: linear-gradient(135deg, var(--primary-500), var(--primary-600));
		color: #12140a;
		box-shadow: 0 8px 24px -12px rgba(201, 224, 1, 0.5);
	}

	.cta-button.primary:hover {
		transform: translateY(-3px);
		box-shadow: 0 16px 32px -16px rgba(201, 224, 1, 0.55);
		background: linear-gradient(135deg, #deea6f, var(--primary-500));
	}

	.info-section {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.info-section h2 {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0;
		text-align: center;
	}

	.info-section ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.info-section li {
		position: relative;
		padding-left: 1.75rem;
		line-height: 1.6;
	}

	.info-section li::before {
		content: "✓";
		position: absolute;
		left: 0;
		top: 0;
		color: #c9e001;
		font-weight: 700;
	}

	.info-section a {
		color: var(--primary-300);
		font-weight: 600;
		text-decoration: none;
	}

	.info-section a:hover {
		text-decoration: underline;
	}

	@media (max-width: 600px) {
		.hero-section h1 {
			font-size: 2.25rem;
		}

		.hero-subtitle {
			font-size: 1.05rem;
		}

		.cta-button {
			width: 100%;
			text-align: center;
		}
	}
</style>
