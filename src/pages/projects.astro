---
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/PageIntro.astro';
import { ProjectsBrowser } from '@/components/ProjectsBrowser';
---

<Layout
  title="Projects | Parents in Tech"
  description="Browse every public Parents in Tech repository, open its GitHub codebase, and follow demo URLs when a project publishes one."
>
  <PageIntro
    eyebrow="Projects"
    title="Browse the repos, codebases, and demo URLs behind the community."
    lead="This page is meant to reflect the actual GitHub organization: every public repository, its codebase, and its demo link whenever a project publishes one."
  />

  <section class="pb-8 md:pb-12">
    <div class="page-shell">
      <div class="editorial-panel grid gap-px overflow-hidden lg:grid-cols-3">
        <div class="surface-wash p-6 md:p-7">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary">All</p>
          <p class="mt-3 text-sm leading-7 text-muted-foreground">Browse the full organization and open the GitHub codebase for any project you want to inspect.</p>
        </div>
        <div class="surface-wash p-6 md:p-7">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary">Recently updated</p>
          <p class="mt-3 text-sm leading-7 text-muted-foreground">See what moved most recently when you want the quickest view of what the community is actively touching.</p>
        </div>
        <div class="surface-wash p-6 md:p-7">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary">Needs contributors</p>
          <p class="mt-3 text-sm leading-7 text-muted-foreground">Shows repositories whose current metadata signals contributor demand. If none are tagged that way, the page says so honestly.</p>
        </div>
      </div>

      <ProjectsBrowser client:visible />
    </div>
  </section>
</Layout>
