---
import ContributionPath from '@/components/ContributionPath.astro';
import { FaqList } from '@/components/FaqList';
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/PageIntro.astro';
import { contributionTracks, inviteFaq, journeySteps, socialLinks } from '@/lib/site';
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';

const url = new URL(Astro.request.url);
const success = url.searchParams.get('success');
const error = url.searchParams.get('error');

const errorCopy: Record<string, string> = {
  'missing-identifier': 'Please provide a valid GitHub username or email address.',
  'user-not-found': 'GitHub user not found. Check the username and try again.',
  'already-member': "You're already a member of the Parents in Tech organization.",
  'pending-invitation': 'You already have a pending invitation. Check your email for the GitHub invite.',
  'membership-conflict': "GitHub reports you're already associated with the organization, but the status could not be verified cleanly.",
  'validation-failed': 'GitHub validation failed. Check the identifier and try again.',
  'need-org-admin': 'The GitHub token needs organization admin permissions to create invitations.',
  'permission-denied': 'The invite request could not be sent because of GitHub permissions.',
  'server-config': 'There is a server configuration issue with the GitHub token.',
  'github-api': 'GitHub returned an API error. Please try again later.',
  'unexpected': 'An unexpected error occurred while processing the invitation.',
};

const githubHref = socialLinks.find((link) => link.label === 'GitHub')?.href ?? 'https://github.com/parents-in-tech';
---

<Layout
  title="Contribute | Parents in Tech"
  description="Learn how Parents in Tech handles open-source contribution, request access to the GitHub organization, and contribute to mission-aligned projects."
>
  <PageIntro
    eyebrow="Contribute"
    title="Contribute in the open, and keep the mission intact."
    lead="Parents in Tech follows open-source contribution norms and welcomes code, docs, design, testing, and stewardship work that supports the mission."
  />

  <ContributionPath items={contributionTracks} />

  <section class="section-space pt-2">
    <div class="page-shell grid gap-6 lg:grid-cols-3">
      {journeySteps.slice(1).map((step, index) => (
        <article class="editorial-panel p-7">
          <div class="eyebrow">Step 0{index + 2}</div>
          <h2 class="mt-5 text-3xl leading-tight">{step.title}</h2>
          <p class="mt-4 text-sm leading-7 text-muted-foreground">{step.description}</p>
          {step.href && (
            <a href={step.href} class="mt-6 inline-flex text-sm font-semibold text-primary hover:text-primary/80">
              Go there
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="section-space pt-4">
    <div class="page-shell grid gap-6 xl:grid-cols-[0.92fr_1.08fr]">
      <article class="editorial-panel p-7 md:p-8" id="github-invite">
        <div class="eyebrow">Get involved</div>
        <h2 class="mt-5 text-3xl leading-tight md:text-4xl">Request GitHub access when you are ready to help directly.</h2>
        <p class="mt-4 text-sm leading-7 text-muted-foreground md:text-base">
          The GitHub organization is where the repositories live. Request access when you want to contribute directly through open-source workflows.
        </p>
        <a
          href={githubHref}
          target="_blank"
          rel="noreferrer"
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary/80"
        >
          Browse the org first →
        </a>
      </article>

      <div class="grid gap-6">
        {success && (
          <Alert variant="success">
            <AlertTitle>Invitation sent</AlertTitle>
            <AlertDescription>
              GitHub should send the organization invitation by email. Once it arrives, you can accept it and start contributing to the repos.
            </AlertDescription>
          </Alert>
        )}

        {error && (
          <Alert variant="destructive">
            <AlertTitle>Invitation failed</AlertTitle>
            <AlertDescription>
              {errorCopy[error] ?? 'There was an issue sending the invitation. Please try again or contact hello@parentsintech.org.'}
            </AlertDescription>
          </Alert>
        )}

        {!success && (
          <div class="editorial-panel p-7 md:p-8">
            <div class="eyebrow">GitHub access</div>
            <h2 class="mt-5 text-3xl leading-tight md:text-4xl">Request an organization invitation.</h2>
            <p class="mt-4 text-sm leading-7 text-muted-foreground md:text-base">
              Use your GitHub username or the email address associated with your GitHub account.
            </p>

            <form method="POST" action="/api/invite" class="mt-8 grid gap-4">
              <label class="grid gap-2 text-sm font-medium text-foreground" for="identifier">
                GitHub username or email
                <Input
                  type="text"
                  id="identifier"
                  name="identifier"
                  placeholder="your-username or email@example.com"
                  required
                />
              </label>

              <Button type="submit" className="w-full sm:w-fit">
                Request invite
              </Button>
            </form>
          </div>
        )}

        <div class="editorial-panel p-7 md:p-8">
          <div class="section-heading max-w-none">
            <div class="eyebrow">Before you submit</div>
            <h2 class="text-3xl leading-tight md:text-4xl">A few practical answers.</h2>
          </div>
          <div class="mt-6">
            <FaqList client:visible items={inviteFaq} />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
