---
import type { ContributionTrack } from '@/lib/site';

interface Props {
  items: ContributionTrack[];
}

const { items } = Astro.props;
---

<section class="section-space pt-4">
  <div class="page-shell">
    <div class="editorial-panel overflow-hidden">
      <div class="grid gap-px lg:grid-cols-[0.9fr_1.1fr]">
        <div class="surface-wash p-8 md:p-10">
          <div class="eyebrow">Contribution tracks</div>
          <h2 class="mt-5 text-4xl leading-tight md:text-5xl">Useful work is not limited to code.</h2>
          <p class="mt-5 text-sm leading-7 text-muted-foreground md:text-base">
            Parents in Tech follows open-source contribution norms. Good issues, clear docs, design polish, testing, and code review all help the mission move forward.
          </p>
        </div>

        <div class="grid gap-px md:grid-cols-3">
          {items.map((item) => (
            <article class="surface-wash p-7">
              <h3 class="text-2xl">{item.title}</h3>
              <p class="mt-4 text-sm leading-7 text-muted-foreground">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
