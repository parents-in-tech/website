---
import { ExternalLink, FolderGit2, Globe2 } from 'lucide-react';
import { projects } from '@/data/projects';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const visibleProjects = limit ? projects.slice(0, limit) : projects;
const statuses = {
  active: { label: 'Active', className: 'bg-primary/12 text-primary' },
  'in-development': { label: 'In development', className: 'bg-secondary text-secondary-foreground' },
  'coming-soon': { label: 'Coming soon', className: 'border border-border text-muted-foreground' },
};
---

<div class="grid gap-6 lg:grid-cols-3">
  {visibleProjects.map((project) => {
    const status = statuses[project.status];

    return (
      <article class="editorial-panel flex h-full flex-col p-7">
        <div class="flex flex-wrap items-center gap-2">
          <span class:list={['rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em]', status.className]}>
            {status.label}
          </span>
        </div>

        <h3 class="mt-5 text-[1.65rem] leading-tight">{project.name}</h3>
        <p class="mt-4 text-base font-medium leading-7 text-foreground">{project.tagline}</p>
        {project.description && <p class="mt-3 text-sm leading-7 text-muted-foreground">{project.description}</p>}

        <div class="mt-auto flex flex-wrap gap-3 pt-7">
          {project.repo && (
            <a
              href={project.repo}
              target="_blank"
              rel="noreferrer"
              aria-label={`${project.name} repository`}
              class="inline-flex h-9 items-center justify-center gap-2 rounded-full bg-primary px-4 text-sm font-medium text-primary-foreground transition hover:bg-primary/92"
            >
              <FolderGit2 className="h-4 w-4" />
              Repo
            </a>
          )}
          {project.landing && (
            <a
              href={project.landing}
              target="_blank"
              rel="noreferrer"
              aria-label={`${project.name} landing page`}
              class="inline-flex h-9 items-center justify-center gap-2 rounded-full border border-border bg-background px-4 text-sm font-medium text-foreground transition hover:bg-accent"
            >
              <Globe2 className="h-4 w-4" />
              Landing
            </a>
          )}
          {project.demo && (
            <a
              href={project.demo}
              target="_blank"
              rel="noreferrer"
              aria-label={`${project.name} demo`}
              class="inline-flex h-9 items-center justify-center gap-2 rounded-full border border-border bg-background px-4 text-sm font-medium text-foreground transition hover:bg-accent"
            >
              <ExternalLink className="h-4 w-4" />
              Demo
            </a>
          )}
        </div>
      </article>
    );
  })}
</div>
