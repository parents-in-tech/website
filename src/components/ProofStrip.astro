---
import type { ProofItem } from '@/lib/site';

interface Props {
  items: ProofItem[];
}

const { items } = Astro.props;
---

<section class="pb-8 md:pb-12">
  <div class="page-shell">
    <div class="editorial-panel grid gap-px overflow-hidden md:grid-cols-4">
      {items.map((item) => (
        <div class="surface-wash p-6 md:p-7">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary">{item.label}</p>
          <p class="mt-3 text-sm leading-7 text-muted-foreground">{item.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>
